load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

CXX_COMMON = [
    "-Werror",
    "-Wno-reorder",
    "-Wno-unused-parameter",
    "-Wno-implicit-fallthrough",
    "-DNDEBUG",
]

cc_binary(
    name = "portsyncd",
    srcs = glob(["*.cpp", "*.h"]),
    cxxopts = CXX_COMMON,
    dynamic_deps = [
        "@sonic-swss-common//:swsscommon_shared",
        "@libnl3//:libnl_3_shared",
        "@libnl3//:libnl_nf_3_shared",
        "@libnl3//:libnl_route_3_shared",
        "@libyang3//:yang_shared",
    ],
    deps = [
        "//:liborch",
        "//lib:libswss",
        "@sonic-swss-common//:swsscommon",
        "@libnl3//:libnl_3",
        "@libnl3//:libnl_route_3",
    ],
)

# tests_portsyncd compiles linksync.cpp itself (Make: tests_portsyncd_SOURCES +=
# $(top_srcdir)/portsyncd/linksync.cpp, with -I$(top_srcdir)/portsyncd), so the
# source is exported and :linksync_hdrs only supplies the include path -- the
# test includes "linksync.h" unqualified while linksync.cpp uses the
# "portsyncd/linksync.h" spelling, and both have to resolve.
exports_files(["linksync.cpp"])

cc_library(
    name = "linksync_hdrs",
    hdrs = ["linksync.h"],
    includes = ["."],
    deps = ["@sonic-swss-common//:swsscommon"],
)
