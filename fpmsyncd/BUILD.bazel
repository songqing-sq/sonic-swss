load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

CXX_COMMON = [
    "-Werror",
    "-Wno-reorder",
    "-Wno-unused-parameter",
    "-Wno-implicit-fallthrough",
    "-DNDEBUG",
]

genrule(
    name = "libnl3_compat_h",
    outs = ["libnl3_compat/libnl3/netlink/netlink.h"],
    cmd = "echo '#include <netlink/netlink.h>' > $@",
)

cc_library(
    name = "libnl3_compat",
    hdrs = [":libnl3_compat_h"],
    includes = ["libnl3_compat"],
    deps = ["@libnl3//:libnl_3"],
)

cc_binary(
    name = "fpmsyncd",
    srcs = glob([
        "*.cpp",
        "**/*.h",
    ]),
    cxxopts = CXX_COMMON,
    dynamic_deps = [
        "@sonic-swss-common//:swsscommon_shared",
        "@libnl3//:libnl_3_shared",
        "@libnl3//:libnl_nf_3_shared",
        "@libnl3//:libnl_route_3_shared",
        "@libyang3//:yang_shared",
    ],
    includes = ["."],
    deps = [
        ":libnl3_compat",
        "//warmrestart",
        "//lib:libswss",
        "@sonic-swss-common//:swsscommon",
        "@libnl3//:libnl_3",
        "@libnl3//:libnl_route_3",
    ],
)

# fpmsyncd.h is here for orchagent; fpmlink.cpp and routesync.cpp are the two
# sources tests/mock_tests compiles into its gtest binary (Make:
# tests_fpmsyncd_SOURCES += $(top_srcdir)/fpmsyncd/{fpmlink,routesync}.cpp).
# The suite cannot link :fpmsyncd's objects instead -- it swaps the warmstart
# helper and ProducerStateTable for fakes of its own, and fpmsyncd.cpp brings a
# second main() along.
exports_files([
    "fpmlink.cpp",
    "fpmsyncd.h",
    "routesync.cpp",
])

# Headers only, for that suite: it includes fpmlink.h/routesync.h both bare and
# repo-root qualified (Make: -I$(top_srcdir)/fpmsyncd on top of tests_INCLUDES).
cc_library(
    name = "fpmsyncd_hdrs",
    hdrs = glob(["**/*.h"]),
    includes = ["."],
    deps = [
        # fpminterface.h wants <libnl3/netlink/netlink.h>, the same spelling
        # :fpmsyncd needs the shim for.
        ":libnl3_compat",
        "//lib:libswss_hdrs",
        "//warmrestart:warmrestart_hdrs",
        "@libnl3//:libnl_3",
        "@libnl3//:libnl_route_3",
        "@sonic-swss-common//:swsscommon",
    ],
)

filegroup(
    name = "fpmsyncd_scripts",
    srcs = ["bgp_eoiu_marker.py"],
)
