module(
    name = "sonic-swss",
    version = "1.0.0",
)

bazel_dep(name = "rules_cc", version = "0.2.16")
bazel_dep(name = "sonic-swss-common", version = "1.0.0")
bazel_dep(name = "sonic-sairedis", version = "1.0.0", repo_name = "sonic_sairedis")
bazel_dep(name = "sai", version = "0.0.0")
bazel_dep(name = "sonic-build-infra", version = "0.0.0", repo_name = "sonic_rules")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "protobuf", version = "29.0")
bazel_dep(name = "libnl3", version = "3.7.0")
bazel_dep(name = "libteam", version = "1.31-1")
bazel_dep(name = "libyang3", version = "3.12.2")
bazel_dep(name = "sonic-dash-api", version = "1.0.0")

bazel_dep(name = "rules_distroless", version = "0.0.0", repo_name = "rules_deb")
bazel_dep(name = "rules_rust", version = "0.61.0")

# gtest/gmock for tests/mock_tests (Make links -lgtest -lgtest_main -lgmock
# -lgmock_main there). Not marked dev_dependency: this module is also consumed
# as a non-root dependency, and dev deps are dropped in that case, which would
# leave @googletest unresolvable.
bazel_dep(name = "googletest", version = "1.15.2")

# Rust crate_universe for countersyncd
crate = use_extension("@rules_rust//crate_universe:extension.bzl", "crate")
crate.from_cargo(
    name = "swss_crates",
    cargo_lockfile = "//:Cargo.lock",
    manifests = [
        "//:Cargo.toml",
        "//crates/countersyncd:Cargo.toml",
    ],
)
crate.annotation(
    crate = "swss-common",
    repositories = ["swss_crates"],
    override_target_lib = "@sonic-swss-common//crates/swss-common:swss_common",
)
use_repo(crate, "swss_crates")

apt = use_extension("@rules_deb//apt:extensions.bzl", "apt")
apt.sources_list(
    architectures = ["amd64", "arm64"],
    components = ["main"],
    suites = [
        "trixie",
        "trixie-updates",
    ],
    uris = ["https://snapshot.debian.org/archive/debian/20260409T202916Z"],
)
apt.sources_list(
    architectures = ["amd64", "arm64"],
    components = ["main"],
    suites = ["trixie-security"],
    uris = ["https://snapshot.debian.org/archive/debian-security/20260409T182303Z"],
)
apt.install(
    dependency_set = "swss_apt_deps",
    packages = [
        "libhiredis-dev",
        "libjansson-dev",
        "libyaml-cpp-dev",
        "libzmq3-dev",
        "libjemalloc-dev",
        # Test-only: a sandboxed test has no installed debs, so the whole .so
        # closure the mock_tests binaries load at runtime has to reach the
        # runfiles as data (the shared cc test runner unpacks these :data tars
        # into a throwaway sysroot). The -dev packages above only carry the
        # unversioned link-time .so; the runtime artifacts live in the library
        # packages below. swss-common declares the same libraries in its own
        # isolated @swss_deps pool, which is invisible from here, hence the
        # duplicates. amd64 only -- tests run on the exec platform.
        "libhiredis1.1.0:amd64",
        "libzmq5:amd64",
        "libjansson4:amd64",
        "libboost-serialization1.83.0:amd64",
        "libuuid1:amd64",
        "liblua5.1-0:amd64",
        "libpcre2-8-0:amd64",
        "libpcre2-16-0:amd64",
        "libpcre2-32-0:amd64",
        "libpcre2-posix3:amd64",
        "libxxhash0:amd64",
        "zlib1g:amd64",
        "libdbus-1-3:amd64",
        "libsystemd0:amd64",
        # Test-only: the full trixie glibc family, per the sonic_cc_gtest_test
        # convention. libc6 carries libc/libm/ld-linux, so the runner finds a
        # loader matching the libc it stages and both halves of glibc come from
        # one package. Declared explicitly rather than relying on the import
        # closure happening to stage them into _solib_*.
        "libc6:amd64",
        "libgcc-s1:amd64",
        "libstdc++6:amd64",
    ],
    suites = [
        "trixie",
        "trixie-updates",
        "trixie-security",
    ],
)
use_repo(apt, "swss_apt_deps")
