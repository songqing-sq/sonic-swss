load("@rules_cc//cc:cc_binary.bzl", "cc_binary")

package(default_visibility = ["//visibility:public"])

CXX_COMMON = [
    "-Werror",
    "-Wno-reorder",
    "-Wno-unused-parameter",
    "-Wno-implicit-fallthrough",
    "-Wno-error=class-memaccess",
    "-Wno-error=unused-result",
    "-DNDEBUG",
]

CFGMGR_HDRS = glob(["*.h"])

exports_files(["shellcmd.h"])

filegroup(
    name = "cfgmgr_lua_scripts",
    srcs = glob(["buffer_*.lua"]),
)

cc_binary(
    name = "vlanmgrd",
    srcs = ["vlanmgrd.cpp", "vlanmgr.cpp"] + CFGMGR_HDRS,
    cxxopts = CXX_COMMON,
    dynamic_deps = [
        "@sonic-swss-common//:swsscommon_shared",
        "@libnl3//:libnl_3_shared",
        "@libnl3//:libnl_nf_3_shared",
        "@libnl3//:libnl_route_3_shared",
        "@libyang3//:yang_shared",
    ],
    deps = ["//:liborch"],
)

