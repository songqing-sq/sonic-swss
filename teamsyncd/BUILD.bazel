load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

CXX_COMMON = [
    "-Werror",
    "-Wno-reorder",
    "-Wno-unused-parameter",
    "-Wno-implicit-fallthrough",
    "-DNDEBUG",
]

cc_binary(
    name = "teamsyncd",
    srcs = glob(["*.cpp", "*.h"]),
    cxxopts = CXX_COMMON,
    dynamic_deps = [
        "@sonic-swss-common//:swsscommon_shared",
        "@libnl3//:libnl_3_shared",
        "@libnl3//:libnl_genl_3_shared",
        "@libnl3//:libnl_nf_3_shared",
        "@libnl3//:libnl_route_3_shared",
        "@libnl3//:libnl_cli_3_shared",
        "@libyang3//:yang_shared",
        "@libteam//:libteam_shared",
        "@libteam//:libteamdctl_shared",
    ],
    deps = [
        "@sonic-swss-common//:swsscommon",
        "@libnl3//:libnl_3",
        "@libnl3//:libnl_route_3",
        "@libteam//:libteam",
        "@libteam//:libteamdctl",
        "@swss_apt_deps//libhiredis-dev:libhiredis",
    ],
)

# tests/mock_tests compiles teamsync.cpp straight into tests_teamsyncd (Make:
# tests_teamsyncd_SOURCES += $(top_srcdir)/teamsyncd/teamsync.cpp, with
# -I$(top_srcdir)/teamsyncd). The source is exported rather than wrapped in a
# library so the test keeps compiling it with its own flags and the mocks it
# links stay free to interpose on team/teamdctl; :teamsync_hdrs only carries the
# include path for "teamsync.h" and its transitive headers.
exports_files(["teamsync.cpp"])

cc_library(
    name = "teamsync_hdrs",
    hdrs = ["teamsync.h"],
    includes = ["."],
    deps = [
        "@libteam//:libteam",
        "@sonic-swss-common//:swsscommon",
    ],
)
