# swss mock unit tests (Make: tests/mock_tests/Makefile.am).
#
# Make builds nine noinst_PROGRAMS here and lists all of them in TESTS, so
# `dh_auto_test` -> `make check` runs them while building the swss deb. Each
# program is a gtest binary that links the daemon sources under test together
# with the mock/fake translation units in this directory; the mocks interpose on
# libswsscommon and libhiredis symbols, which only works because both are linked
# in as shared libraries (definitions in the executable win the dynamic lookup).
# That is why every test binary below uses dynamic_deps exactly like the
# production binaries do -- linking swsscommon statically would leave the real
# implementations in place and the suites would try to reach a real redis.
#
# The suites need no redis: mock_hiredis.cpp fakes the wire protocol and
# mock_dbconnector.cpp builds DBConnector objects around a dummy socket. It does
# read ./database_config.json through a CWD-relative path, hence fixture_mode.

load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@sonic_rules//cc:gtest_test.bzl", "sonic_cc_gtest_test")

package(default_visibility = ["//visibility:public"])

# orchagent/p4orch/tests/p4orch_tests links this one too (Make:
# p4orch_tests_SOURCES += $(top_srcdir)/tests/mock_tests/fake_response_publisher.cpp).
exports_files(["fake_response_publisher.cpp"])

# Make: CFLAGS/CXXFLAGS = -g -O0, DBGFLAGS = -g -DNDEBUG (the non-DEBUG arm).
# The warning set is deliberately not orchagent's CXX_COMMON: the mock sources
# are not held to -Werror there either (Makefile.am passes no -W flags beyond
# AM_CFLAGS/CFLAGS_COMMON, both empty in this tree).
TEST_COPTS = [
    "-g",
    "-O0",
    "-std=c++17",
    "-DNDEBUG",
]

# The .so closure the test binaries load at runtime. First-party libraries come
# in as _files targets because those carry the soname symlinks
# (libswsscommon.so.0 -> .so.0.0.0) that the _solib_* staging lacks; apt
# libraries come in as :data tars the runner unpacks into a throwaway sysroot.
TEST_SO_FILES = [
    "@sonic-swss-common//:swsscommon_files",
    "@libnl3//:libnl_3_files",
    "@libnl3//:libnl_genl_3_files",
    "@libnl3//:libnl_nf_3_files",
    "@libnl3//:libnl_route_3_files",
    "@libnl3//:libnl_cli_3_files",
    "@libyang3//:yang_files",
]

# Only the teamd-facing suites load these.
TEAM_SO_FILES = [
    "@libteam//:libteam_files",
    "@libteam//:libteamdctl_files",
]

TEST_APT_DATA = [
    "@swss_apt_deps//libhiredis1.1.0:data",
    "@swss_apt_deps//libzmq5:data",
    "@swss_apt_deps//libboost-serialization1.83.0:data",
    "@swss_apt_deps//libuuid1:data",
    "@swss_apt_deps//liblua5.1-0:data",
    "@swss_apt_deps//libpcre2-8-0:data",
    "@swss_apt_deps//libpcre2-16-0:data",
    "@swss_apt_deps//libpcre2-32-0:data",
    "@swss_apt_deps//libpcre2-posix3:data",
    "@swss_apt_deps//libxxhash0:data",
    "@swss_apt_deps//zlib1g:data",
    # Per the sonic_cc_gtest_test convention: the runner execs the staged
    # loader, so the glibc family has to be declared, not ridden in on the
    # import closure.
    "@swss_apt_deps//libc6:data",
    "@swss_apt_deps//libgcc-s1:data",
    "@swss_apt_deps//libstdc++6:data",
]

# Every suite pulls these in: the DBConnector/Table/RedisReply fakes plus the
# hiredis stub that keeps them off the wire, and the bazel-only shim that stands
# in for the file the libswsscommon deb installs at an absolute path in Make's
# build container (/var/run/redis/sonic-db/database_config.json).
MOCK_DB_SRCS = [
    "mock_dbconnector.cpp",
    "mock_hiredis.cpp",
    "mock_redisreply.cpp",
    "mock_table.cpp",
    "mock_table.h",
    "bazel/sonic_db_config_env.cpp",
]

# The other absolute path Make's container provides, /usr/share/swss/*.lua, is
# covered by a preloaded interposer instead -- see bazel/swss_lua_path.cpp for
# why it cannot simply be linked in. bazel/lua_setup.sh finds both the shim and
# the scripts in runfiles.
cc_binary(
    name = "libswss_lua_path.so",
    testonly = True,
    srcs = ["bazel/swss_lua_path.cpp"],
    copts = TEST_COPTS,
    linkshared = True,
)

LUA_DATA = [
    "@sonic-swss-common//:lua_scripts",
    ":libswss_lua_path.so",
]

# The libraries that have to stay shared for the mocks to interpose. Suites that
# reach further -- libteam, for instance -- append to this.
SWSS_DYNAMIC_DEPS = [
    "@sonic-swss-common//:swsscommon_shared",
    "@libnl3//:libnl_3_shared",
    "@libnl3//:libnl_genl_3_shared",
    "@libnl3//:libnl_nf_3_shared",
    "@libnl3//:libnl_route_3_shared",
    "@libyang3//:yang_shared",
]

# What every suite links against beyond its own sources.
SWSS_TEST_DEPS = [
    "@googletest//:gtest",
    "@googletest//:gtest_main",
    "@libnl3//:libnl_3",
    "@libnl3//:libnl_route_3",
    "@sonic-swss-common//:swsscommon",
    "@sonic_rules//system_libs:pthread",
    "@swss_apt_deps//libhiredis-dev:libhiredis",
]

# ---------------------------------------------------------------------------
# tests_teamsyncd (Make: tests_teamsyncd_SOURCES)
# ---------------------------------------------------------------------------
# teamsync_ut.cpp redefines team_init/teamdctl_* /sleep and dispatches to the
# real ones via dlsym(RTLD_NEXT), so libteam/libteamdctl must stay shared for
# the interposition to take effect.
cc_binary(
    name = "tests_teamsyncd_bin",
    testonly = True,
    srcs = [
        "teamsync_ut.cpp",
        "//teamsyncd:teamsync.cpp",
    ] + MOCK_DB_SRCS,
    copts = TEST_COPTS,
    dynamic_deps = SWSS_DYNAMIC_DEPS + [
        # libteam.so needs nl_cli_*, same as the teamsyncd binary.
        "@libnl3//:libnl_cli_3_shared",
        "@libteam//:libteam_shared",
        "@libteam//:libteamdctl_shared",
    ],
    includes = ["."],
    deps = SWSS_TEST_DEPS + [
        "//teamsyncd:teamsync_hdrs",
        "@libteam//:libteam",
        "@libteam//:libteamdctl",
    ],
)

sonic_cc_gtest_test(
    name = "tests_teamsyncd",
    binary = ":tests_teamsyncd_bin",
    # mock_dbconnector.cpp does SonicDBConfig::initialize("./database_config.json").
    fixtures = ["database_config.json"],
    fixture_mode = "in_place",
    runtime_debs = TEST_APT_DATA,
    runtime_files = TEST_SO_FILES + TEAM_SO_FILES,
    data = LUA_DATA,
    setup = "bazel/lua_setup.sh",
)

