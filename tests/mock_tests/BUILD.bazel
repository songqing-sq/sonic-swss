# ---------------------------------------------------------------------------
# tests (Make: tests_SOURCES) -- the orchagent suite
# ---------------------------------------------------------------------------
# The big one: nearly all of orchagent compiled straight into a gtest binary
# alongside ~75 test translation units. The orchagent half comes in as
# //orchagent:orchagent_test_srcs so the two source lists cannot drift apart;
# see the comment there for how it relates to orchagent_SOURCES.
#
# SAI stays shared (dynamic_deps below), which is both what Make does
# (LDADD_SAI = -lsaivs -lsairedis -lsaimeta -lsaimetadata) and what the four
# --wrap options require: --wrap only rewrites references in the objects handed
# to *this* link, so keeping libsaimetadata/libsairedis out of the static
# closure leaves their internal calls unwrapped, exactly as in Make. Linking
# them statically would silently redirect those too.
SAI_SO_FILES = [
    "@sai//meta:saimetadata_files",
    "@sonic_rules//protobuf:libprotobuf_files",
    "@sonic_sairedis//lib:sairedis_files",
    "@sonic_sairedis//meta:saimeta_files",
    "@sonic_sairedis//vslib:saivs_files",
]

cc_binary(
    name = "tests_bin",
    testonly = True,
    # Deliberately in Make's tests_SOURCES order rather than sorted: gtest runs
    # test suites in registration order, which is static-initialisation order,
    # which is link order. Sorting this list alphabetically swaps bufferorch_ut
    # with buffermgrdyn_ut and BufferOrchTest.BufferOrchTestLosslessBuffer-
    # ProfilePublish then sees a BUFFER_PROFILE_TABLE entry the buffermgrdyn
    # suite left behind. The suites are not independent, so the order is part of
    # what is being migrated.
    srcs = [
        "aclorch_ut.cpp",
        "aclorch_rule_ut.cpp",
        "portsorch_ut.cpp",
        "routeorch_ut.cpp",
        "qosorch_ut.cpp",
        "bufferorch_ut.cpp",
        "buffermgrdyn_ut.cpp",
        "fdborch/flush_syncd_notif_ut.cpp",
        "macmoveguard/macmoveguard_ut.cpp",
        "fdborch/fdborch_vxlan_ut.cpp",
        "copp_ut.cpp",
        "copporch_ut.cpp",
        "saispy_ut.cpp",
        "consumer_ut.cpp",
        "sfloworh_ut.cpp",
        "tunneldecaporch_ut.cpp",
        "ut_saihelper.cpp",
        "mock_orchagent_main.cpp",
        "mock_consumerstatetable.cpp",
        "mock_subscriberstatetable.cpp",
        "common/mock_shell_command.cpp",
        "mock_sai_api.cpp",
        "bulker_ut.cpp",
        "portmgr_ut.cpp",
        "sflowmgrd_ut.cpp",
        "fake_response_publisher.cpp",
        "swssnet_ut.cpp",
        "flowcounterrouteorch_ut.cpp",
        "orchdaemon_ut.cpp",
        "intfsorch_ut.cpp",
        "evpnmhorch_ut.cpp",
        "vxlanorch_ut.cpp",
        "mux_rollback_ut.cpp",
        "mux_subnet_slicing_ut.cpp",
        "warmrestartassist_ut.cpp",
        "test_failure_handling.cpp",
        "switchorch_ut.cpp",
        "warmrestarthelper_ut.cpp",
        "neighorch_ut.cpp",
        "dashenifwdorch_ut.cpp",
        "dashorch_ut.cpp",
        "dashvnetorch_ut.cpp",
        "dashhaorch_ut.cpp",
        "dashhafloworch_ut.cpp",
        "dashrouteorch_ut.cpp",
        "dashtunnelorch_ut.cpp",
        "dashportmaporch_ut.cpp",
        "dashmeterorch_ut.cpp",
        "twamporch_ut.cpp",
        "stporch_ut.cpp",
        "srv6orch_ut.cpp",
        "flexcounter_ut.cpp",
        "portphyattr_ut.cpp",
        "portphyserdesattr_ut.cpp",
        "counternameupdater_ut.cpp",
        "hftelgroup_ut.cpp",
        "hftelprofile_ut.cpp",
        "mock_orch_test.cpp",
        "mock_dash_orch_test.cpp",
        "zmq_orch_ut.cpp",
        "retrycache_ut.cpp",
        "saihelper_ut.cpp",
        "mock_saihelper.cpp",
        "mirrororch_ut.cpp",
        "mirrororch_sample_port_sai_wrap.cpp",
        "hftelorch_ut.cpp",
        "hftelorch_notify_ut.cpp",
        "hftelorch_is_supported_sai_wrap.cpp",
        "shlorch_ut.cpp",
        "mock_sai_fdb.cpp",
        "mock_sai_tunnel.cpp",
        "icmporch_ut.cpp",
        "icmporch_sai_wrap.cpp",
        "//warmrestart:warmRestartHelper.cpp",
        "//lib:gearboxutils.cpp",
        "//lib:subintf.cpp",
        "//lib:recorder.cpp",
        "//lib:orch_zmq_config.cpp",
        "//orchagent:orchagent_test_srcs",
        "//cfgmgr:portmgr.cpp",
        "//cfgmgr:sflowmgr.cpp",
        "//cfgmgr:buffermgrdyn.cpp",
        "//warmrestart:warmRestartAssist.cpp",
        "//cfgmgr:coppmgr.cpp",
        "common/vxlan_ut_helpers.cpp",
        # orchdaemon.cpp reaches for it, the same way the orchagent binary does.
        "//fpmsyncd:fpmsyncd.h",
        # None of these register a test suite, so where they land in the link
        # does not affect the run order above.
    ] + MOCK_DB_SRCS + glob(
        [
            "*.h",
            "common/*.h",
        ],
        # MOCK_DB_SRCS names it already.
        exclude = ["mock_table.h"],
    ),
    copts = TEST_COPTS,
    dynamic_deps = SWSS_DYNAMIC_DEPS + [
        # Order matters, and it is Make's: LDADD_SAI puts -lsaivs ahead of
        # -lsairedis so that ut_saihelper.cpp's sai_api_initialize/sai_api_query
        # bind to the virtual-switch implementation. Let libsairedis come first
        # and the suite ends up driving the real redis channel instead, where it
        # blocks waiting for a syncd that is not there.
        "@sonic_sairedis//vslib:saivs_shared",
        "@sonic_sairedis//lib:sairedis_shared",
        "@sonic_sairedis//meta:saimeta_shared",
        "@sai//meta:saimetadata_shared",
        "@sonic_rules//protobuf:libprotobuf_shared",
    ],
    includes = ["."],
    linkopts = [
        "-Wl,--wrap=sai_query_stats_st_capability",
        "-Wl,--wrap=sai_query_attribute_capability",
        "-Wl,--wrap=sai_query_attribute_enum_values_capability",
        "-Wl,--wrap=sai_metadata_get_attr_metadata",
    ],
    deps = SWSS_TEST_DEPS + [
        "//cfgmgr:cfgmgr_hdrs",
        "//lib:libswss_hdrs",
        "//orchagent:orchagent_hdrs",
        "//warmrestart:warmrestart_hdrs",
        "@libnl3//:libnl_genl_3",
        "@protobuf//:protobuf",
        "@sai//meta:saimetadata",
        "@sonic-dash-api//:dashapi",
        "@sonic-dash-api//:dashapi_cpp_proto",
        "@sonic_sairedis//vslib:saivs",
        "@sonic_sairedis//lib:sairedis",
        "@sonic_sairedis//meta:saimeta",
        "@swss_apt_deps//libzmq3-dev:libzmq3",
        # hftelorch.cpp includes <yaml-cpp/yaml.h>. Make gets away without saying
        # so in tests_LDADD because the header is installed in its container and
        # the suite never reaches the code paths that need the library.
        "@swss_apt_deps//libyaml-cpp-dev:libyaml-cpp",
    ],
)

sonic_cc_gtest_test(
    name = "tests",
    # 885 test cases across 87 suites against a statically linked orchagent,
    # ~16s warm. "medium" (300s) rather than "small": bazel will note the run is
    # short for the category, but a good part of those 885 cases drive the SAI
    # virtual switch and the margin over 60s is worth keeping on a loaded machine.
    size = "medium",
    binary = ":tests_bin",
    # copp_ut.cpp passes "./copp_cfg.json" to CoppMgr, standing in for the
    # /etc/sonic/copp_cfg.json coppmgr.h hardcodes.
    fixtures = [
        "copp_cfg.json",
        "database_config.json",
    ],
    fixture_mode = "in_place",
    runtime_debs = TEST_APT_DATA,
    runtime_files = TEST_SO_FILES + SAI_SO_FILES,
    data = LUA_DATA,
    setup = "bazel/lua_setup.sh",
)

