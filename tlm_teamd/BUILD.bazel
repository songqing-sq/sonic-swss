load("@rules_cc//cc:cc_binary.bzl", "cc_binary")

package(default_visibility = ["//visibility:public"])

CXX_COMMON = [
    "-Werror",
    "-Wno-reorder",
    "-Wno-unused-parameter",
    "-Wno-implicit-fallthrough",
    "-DNDEBUG",
]

cc_binary(
    name = "tlm_teamd",
    srcs = glob(["*.cpp", "*.h"]),
    cxxopts = CXX_COMMON,
    dynamic_deps = [
        "@sonic-swss-common//:swsscommon_shared",
        "@libnl3//:libnl_3_shared",
        "@libnl3//:libnl_nf_3_shared",
        "@libnl3//:libnl_route_3_shared",
        "@libyang3//:yang_shared",
        "@libteam//:libteamdctl_shared",
    ],
    includes = ["."],
    deps = [
        "//lib:libswss",
        "@sonic-swss-common//:swsscommon",
        "@libteam//:libteamdctl",
        "@swss_apt_deps//libhiredis-dev:libhiredis",
        "@swss_apt_deps//libjansson-dev:libjansson",
    ],
)
